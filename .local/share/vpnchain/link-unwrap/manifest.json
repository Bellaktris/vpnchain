{
    "manifest_version": 3,
    "name": "vpnchain link unwrap",
    "version": "1",
    "description": "Opens the destination of a blocked tracker's link directly, read off the link without contacting the tracker.",
    "permissions": ["declarativeNetRequest"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js", "type": "module" },
    "web_accessible_resources": [{
        "resources": ["unwrap.html"],
        "matches": ["<all_urls>"],
        "use_dynamic_url": true
    }]
}
