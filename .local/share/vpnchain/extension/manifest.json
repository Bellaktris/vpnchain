{
    "manifest_version": 3,
    "name": "vpnchain",
    "version": "3",
    "description": "Keeps the pinned browser off the network unless it was launched on the chain, shows the chain's state, explains the pages it refuses, opens tracker links' destinations directly, and maps the incognito shortcut to the incognito browser.",
    "key": "",
    "permissions": ["declarativeNetRequest", "nativeMessaging", "webNavigation", "alarms", "storage", "proxy"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js", "type": "module" },
    "action": { "default_title": "vpnchain" },
    "commands": {
        "incognito": {
            "suggested_key": { "default": "Ctrl+Shift+N", "mac": "Command+Shift+N" },
            "description": "Open the vpnchain incognito browser"
        }
    },
    "web_accessible_resources": [{
        "resources": ["unwrap.html"],
        "matches": ["<all_urls>"],
        "use_dynamic_url": true
    }]
}
