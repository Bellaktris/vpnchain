{
    "manifest_version": 3,
    "name": "vpnchain",
    "version": "2",
    "description": "Opens the destination of a blocked tracker's link directly, read off the link without contacting the tracker; the incognito shortcut opens the vpnchain incognito browser.",
    "key": "",
    "permissions": ["declarativeNetRequest", "nativeMessaging"],
    "host_permissions": ["<all_urls>"],
    "background": { "service_worker": "background.js", "type": "module" },
    "commands": {
        "incognito": {
            "suggested_key": { "default": "Ctrl+Shift+N", "mac": "Command+Shift+N" },
            "description": "Open the vpnchain incognito browser"
        }
    },
    "web_accessible_resources": [{
        "resources": ["unwrap.html"],
        "matches": ["<all_urls>"],
        "use_dynamic_url": true
    }]
}
